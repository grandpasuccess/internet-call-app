# Internet Call App - Root Environment Variables
# Copy this file to .env in each subdirectory as needed

# Common settings
NODE_ENV=development

# URLs
WEB_URL=http://localhost:3000
API_URL=http://localhost:3001
MOBILE_URL=http://localhost:19000

# WebRTC
STUN_SERVERS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302
# TURN server (optional - configure if you have one)
# TURN_SERVER=
# TURN_USERNAME=
# TURN_PASSWORD=
