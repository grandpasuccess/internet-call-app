# Backend Environment Variables
# Copy to .env and fill in your values

# Application
NODE_ENV=development
PORT=3001

# PostgreSQL Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=internet_call_app
DB_USER=postgres
DB_PASSWORD=your_password_here

# Redis
REDIS_URL=redis://localhost:6379

# JWT Authentication
JWT_SECRET=your_jwt_secret_key_here_change_in_production
JWT_EXPIRES_IN=24h

# CORS - Comma-separated list of allowed origins
# Include your frontend URLs (web app and mobile dev servers)
CORS_ORIGIN=http://localhost:3000,http://localhost:19000

# WebRTC ICE Servers
# STUN servers help with NAT traversal (free, publicly available)
STUN_SERVERS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302

# TURN Server (required for connections behind symmetric NATs)
# Use a service like Twilio, Xirsys, or self-host Coturn
# TURN_SERVER=your-turn-server.com
# TURN_USERNAME=your_username
# TURN_PASSWORD=your_password

# Server
LOG_LEVEL=info
