# Mobile Frontend Environment Variables
# Copy to .env and fill in your values

# API URL (backend server) - Expo uses EXPO_ prefix by convention
EXPO_API_URL=http://localhost:3001

# Socket.io URL (same as backend for development)
EXPO_SOCKET_URL=http://localhost:3001

# WebRTC ICE Servers
EXPO_TURN_SERVER=
EXPO_TURN_USERNAME=
EXPO_TURN_PASSWORD=
